# Local Development Environment Variables

# Node environment - automatically set by npm scripts
NODE_ENV=development

# Session secret for local development (change in production)
SESSION_SECRET=local-dev-session-secret-change-in-production

# Base URL for local development
BASE_URL=http://localhost:5000

# Optional: Database URL (leave empty to use memory store)
# DATABASE_URL=

# Optional: SendGrid API Key (for contact form emails)
# SENDGRID_API_KEY=

# Optional: Email settings
# FROM_EMAIL=contact@hwinnwin.com