# Environment Variables for Local Development

# Optional: Database URL (if you want to use PostgreSQL locally)
# DATABASE_URL=postgresql://username:password@localhost:5432/your_database

# Optional: Session secret (defaults to dev secret if not set)
# SESSION_SECRET=your-secure-session-secret-here

# Optional: Base URL for SEO (defaults to https://hwinnwin.com)
# BASE_URL=http://localhost:5000

# Optional: SendGrid API Key (for contact form emails)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Optional: Email settings
# FROM_EMAIL=contact@hwinnwin.com

# Node environment (automatically set by npm scripts)
NODE_ENV=development